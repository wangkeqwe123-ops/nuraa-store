# Runtime connection for Next.js/Vercel (Supabase transaction-mode pooler, port 6543).
# URL-encode special characters in the database password.
DATABASE_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Schema migrations only (Supabase session-mode pooler, port 5432).
DIRECT_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

ADMIN_EMAIL="admin@nuraa.sa"
ADMIN_PASSWORD="change-this-before-production"
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_set-this-only-in-a-server-environment"
SUPABASE_HOMEPAGE_BUCKET="homepage-media"
SUPABASE_PRODUCT_BUCKET="product-media"

# Checkout configuration. "mock" is accepted only outside production.
# Production checkout intentionally remains closed until a real Saudi PSP adapter is configured.
PAYMENT_PROVIDER="mock"
STORE_SHIPPING_FEE_SAR="25"
STORE_FREE_SHIPPING_THRESHOLD_SAR="250"
# Decimal rate: 0.15 means 15%. Confirm the applicable VAT treatment before launch.
STORE_TAX_RATE="0"
