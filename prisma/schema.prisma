generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  EN
  AR
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductMediaType {
  MAIN_IMAGE
  DETAIL_IMAGE
  VIDEO
}

enum AnalyticsEventType {
  PAGE_VIEW
  PRODUCT_VIEW
  ADD_TO_CART
  CHECKOUT_START
  PURCHASE
}

enum TrafficChannel {
  TIKTOK
  FACEBOOK
  GOOGLE
  DIRECT
  OTHER
}

enum HomepageMediaType {
  IMAGE
  VIDEO
}

enum HomepageSectionStatus {
  ACTIVE
  INACTIVE
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  SHIPPED
  DELIVERED
}

enum ShipmentStatus {
  PENDING
  SHIPPED
  DELIVERED
  RETURNED
}

enum InventoryReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String?
  passwordHash String
  isActive     Boolean        @default(true)
  sessions     AdminSession[]
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  adminId   String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

model Category {
  id           String                @id @default(cuid())
  slug         String                @unique
  sortOrder    Int                   @default(0)
  isActive     Boolean               @default(true)
  products     Product[]
  translations CategoryTranslation[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model CategoryTranslation {
  id          String   @id @default(cuid())
  categoryId  String
  locale      Locale
  name        String
  description String?
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([locale])
}

model Product {
  id              String               @id @default(cuid())
  slug            String               @unique
  sku             String               @unique
  categoryId      String?
  price           Decimal              @db.Decimal(10, 2)
  compareAtPrice  Decimal?             @db.Decimal(10, 2)
  currency        String               @default("SAR")
  stock           Int                  @default(0)
  status          ProductStatus        @default(DRAFT)
  isFeatured      Boolean              @default(false)
  rating          Decimal              @default(0.0) @db.Decimal(2, 1)
  reviewCount     Int                  @default(0)
  sortOrder       Int                  @default(0)
  fragranceFamily String?
  category        Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  translations    ProductTranslation[]
  media           ProductMedia[]
  analyticsEvents AnalyticsEvent[]
  dailyAnalytics  ProductAnalytics[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  reservations    InventoryReservation[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?

  @@index([categoryId])
  @@index([status, isFeatured])
  @@index([status, deletedAt])
  @@index([createdAt])
}

model Customer {
  id        String   @id @default(cuid())
  email     String   @unique
  phone     String
  name      String
  locale    Locale   @default(EN)
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([createdAt])
}

model Cart {
  id        String     @id @default(cuid())
  token     String     @unique
  status    CartStatus @default(ACTIVE)
  locale    Locale     @default(EN)
  expiresAt DateTime
  items     CartItem[]
  order     Order?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status, expiresAt])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([productId])
}

model Order {
  id                String            @id @default(cuid())
  orderNumber       String            @unique
  publicToken       String            @unique
  cartId            String?           @unique
  customerId        String
  status            OrderStatus       @default(PENDING_PAYMENT)
  paymentStatus     PaymentStatus     @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  subtotal          Decimal           @db.Decimal(12, 2)
  shippingAmount    Decimal           @default(0) @db.Decimal(12, 2)
  taxAmount         Decimal           @default(0) @db.Decimal(12, 2)
  discountAmount    Decimal           @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal           @db.Decimal(12, 2)
  currency          String            @default("SAR")
  locale            Locale            @default(EN)
  customerName      String
  customerEmail     String
  customerPhone     String
  shippingAddress   Json
  utmSource         String?
  utmCampaign       String?
  utmContent        String?
  notes             String?
  cart              Cart?             @relation(fields: [cartId], references: [id], onDelete: SetNull)
  customer          Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items             OrderItem[]
  payments          Payment[]
  shipment          Shipment?
  reservations      InventoryReservation[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([fulfillmentStatus, createdAt])
  @@index([customerId, createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String?
  sku         String
  productName String
  imageUrl    String?
  unitPrice   Decimal  @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal  @db.Decimal(12, 2)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  provider          String
  providerPaymentId String?       @unique
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("SAR")
  idempotencyKey    String        @unique
  failureReason     String?
  metadata          Json?
  paidAt            DateTime?
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([orderId, status])
}

model Shipment {
  id             String         @id @default(cuid())
  orderId        String         @unique
  carrier        String?
  trackingNumber String?
  status         ShipmentStatus @default(PENDING)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model WebhookEvent {
  id              String   @id @default(cuid())
  provider        String
  externalEventId String
  eventType       String
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime @default(now())

  @@unique([provider, externalEventId])
  @@index([provider, createdAt])
}

model InventoryReservation {
  id        String                     @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  status    InventoryReservationStatus @default(ACTIVE)
  expiresAt DateTime
  order     Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product                    @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt

  @@unique([orderId, productId])
  @@index([status, expiresAt])
  @@index([productId, status])
}

model AnalyticsEvent {
  id               String             @id @default(cuid())
  eventType        AnalyticsEventType
  visitorId        String
  sessionId        String
  productId        String?
  product          Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  orderReference   String?
  quantity         Int?
  revenue          Decimal?           @db.Decimal(12, 2)
  currency         String             @default("SAR")
  path             String?
  referrer         String?
  trafficSourceId  String?
  trafficSource    TrafficSource?     @relation(fields: [trafficSourceId], references: [id], onDelete: SetNull)
  deduplicationKey String?            @unique
  metadata         Json?
  occurredAt       DateTime           @default(now())
  createdAt        DateTime           @default(now())

  @@index([eventType, occurredAt])
  @@index([visitorId, occurredAt])
  @@index([sessionId, occurredAt])
  @@index([productId, eventType, occurredAt])
  @@index([trafficSourceId, eventType, occurredAt])
  @@index([orderReference])
}

model TrafficSource {
  id          String           @id @default(cuid())
  fingerprint String           @unique
  channel     TrafficChannel
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  firstSeenAt DateTime         @default(now())
  lastSeenAt  DateTime         @updatedAt
  events      AnalyticsEvent[]

  @@index([channel])
  @@index([utmSource])
  @@index([utmCampaign])
}

model ProductAnalytics {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  date           DateTime @db.Date
  pageViews      Int      @default(0)
  productViews   Int      @default(0)
  addToCarts     Int      @default(0)
  checkoutStarts Int      @default(0)
  purchases      Int      @default(0)
  unitsSold      Int      @default(0)
  revenue        Decimal  @default(0) @db.Decimal(12, 2)
  uniqueVisitors Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([productId, date])
  @@index([date])
  @@index([productId, date])
}

model ProductTranslation {
  id               String   @id @default(cuid())
  productId        String
  locale           Locale
  name             String
  shortDescription String?
  description      String
  benefits         String[]
  usage            String?
  scentFamily      String?
  fragranceNotes   String[] @default([])
  topNotes         String[]
  heartNotes       String[]
  baseNotes        String[]
  usageOccasions   String[]
  story            String?
  giftDescription  String?
  metaTitle        String?
  metaDescription  String?
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@index([locale])
}

model ProductMedia {
  id        String           @id @default(cuid())
  productId String
  type      ProductMediaType @default(DETAIL_IMAGE)
  url       String
  fileName  String?
  mimeType  String?
  altEn     String?
  altAr     String?
  sortOrder Int              @default(0)
  isPrimary Boolean          @default(false)
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@index([productId, isPrimary])
}

model HomepageSection {
  id              String                @id @default(cuid())
  sectionKey      String                @unique @map("section_key")
  title           String
  subtitle        String?
  mediaType       HomepageMediaType     @default(IMAGE) @map("media_type")
  desktopMediaUrl String?               @map("desktop_media_url")
  mobileMediaUrl  String?               @map("mobile_media_url")
  buttonText      String?               @map("button_text")
  buttonLink      String?               @map("button_link")
  status          HomepageSectionStatus @default(ACTIVE)
  sortOrder       Int                   @default(0) @map("sort_order")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  @@index([status, sortOrder])
  @@map("homepage_sections")
}
